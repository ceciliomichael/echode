{
  "name": "echode",
  "displayName": "echode",
  "description": "Agentic Coding",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "echode-sidebar",
          "title": "Echode",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "echode-sidebar": [
        {
          "type": "webview",
          "id": "echode.sidebar",
          "name": "AI Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "echode.newChat",
        "title": "New Chat",
        "icon": "$(add)"
      },
      {
        "command": "echode.openHistory",
        "title": "Open History",
        "icon": "$(history)"
      },
      {
        "command": "echode.openSettings",
        "title": "Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "echode.newChat",
          "when": "view == echode.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "echode.openHistory",
          "when": "view == echode.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "echode.openSettings",
          "when": "view == echode.sidebar",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "cd webview-ui && npm run build && cd .. && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "openai": "^6.9.1",
    "remark-gfm": "^4.0.1"
  }
}
