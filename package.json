{
  "name": "echode",
  "displayName": "Echode",
  "description": "Agentic Coding",
  "version": "1.0.0",
  "publisher": "EchoSphere",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceciliomichael/echode"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "echode-sidebar",
          "title": "Echode",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "echode-sidebar": [
        {
          "type": "webview",
          "id": "echode.sidebar",
          "name": "AI Assistant",
          "icon": "$(robot)"
        }
      ]
    },
    "commands": [
      {
        "command": "echode.newChat",
        "title": "New Chat",
        "icon": "$(add)"
      },
      {
        "command": "echode.openHistory",
        "title": "Open History",
        "icon": "$(history)"
      },
      {
        "command": "echode.openSettings",
        "title": "Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "echode.newChat",
          "when": "view == echode.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "echode.openHistory",
          "when": "view == echode.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "echode.openSettings",
          "when": "view == echode.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Echode",
      "properties": {
        "echode.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic diagnostics capture after AI file edits/creations to detect lint and compile errors"
        },
        "echode.diagnostics.delay": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay in milliseconds to wait for language server analysis after file write (default: 800ms)"
        },
        "echode.diagnostics.maxIterations": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of automatic fix attempts per file when diagnostics are detected (default: 3)"
        },
        "echode.diagnostics.timeout": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 15000,
          "description": "Maximum time in milliseconds to wait for diagnostics collection (default: 5000ms)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "cd webview-ui && npm run build && cd .. && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "cd webview-ui && npm run build && cd .. && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "postinstall": "electron-rebuild -v 37.0.0 -f -w better-sqlite3",
    "rebuild": "electron-rebuild -v 37.0.0 -f -w better-sqlite3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "better-sqlite3": "^11.10.0",
    "fastest-levenshtein": "^1.0.16",
    "openai": "^6.9.1",
    "remark-gfm": "^4.0.1"
  }
}
