{
  "name": "echode-markdown-viewer",
  "displayName": "EchoDE Markdown Viewer",
  "description": "The focused, theme-aware Markdown and Mermaid viewer from EchoDE.",
  "version": "1.0.0",
  "type": "module",
  "publisher": "EchoSphere",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceciliomichael/echode.git",
    "directory": "echode-markdown-viewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "gfm",
    "echode"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:echodeMarkdownViewer.openPreview",
    "onCommand:echodeMarkdownViewer.openPreviewToSide",
    "onWebviewPanel:echodeMarkdownViewer.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "echodeMarkdownViewer.openPreview",
        "title": "Open Markdown Preview",
        "category": "EchoDE Markdown Viewer",
        "icon": "$(open-preview)"
      },
      {
        "command": "echodeMarkdownViewer.openPreviewToSide",
        "title": "Open Markdown Preview to the Side",
        "category": "EchoDE Markdown Viewer",
        "icon": "$(split-horizontal)"
      }
    ],
    "keybindings": [
      {
        "command": "echodeMarkdownViewer.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && (editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "echodeMarkdownViewer.openPreviewToSide",
          "when": "editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "echodeMarkdownViewer.openPreview",
          "when": "editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "echodeMarkdownViewer.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build:extension": "node esbuild.mjs",
    "build": "npm run check-types && npm run build:webview && npm run build:extension",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package --out ../builds/echode-markdown-viewer.vsix"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "mermaid": "^11.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vscode/vsce": "^3.7.0",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
